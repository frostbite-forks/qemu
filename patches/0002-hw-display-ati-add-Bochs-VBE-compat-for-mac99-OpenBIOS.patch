From 147fe8005b4fb33447d28c137427ebd128731dd6 Mon Sep 17 00:00:00 2001
From: Bruno Castelló <bfcastello@gmail.com>
Date: Fri,  5 Jun 2026 03:21:55 -0300
Subject: [PATCH 2/5] hw/display/ati: add Bochs VBE compat region for
 mac99/OpenBIOS boot

OpenBIOS vga.fs expects Bochs VBE registers at MMIO BAR2 offset 0x500
(PCI_VGA_BOCHS_OFFSET) to set the framebuffer display mode.  The code
path is:

  vga.fs: map-mmio  -> maps ati-vga BAR2
  vga.fs: vbe-init  -> writes VBE_DISPI_INDEX_* at mmio_addr + 0x500

For the standard QEMU VGA device, BAR2 contains a Bochs VBE sub-region
at exactly 0x500 (see pci_std_vga_mmio_region_init in vga-pci.c).  For
ati-vga, BAR2 is the raw ATI register space; offset 0x500 is not
decoded, so the VBE writes silently vanish.  The result:

  - OpenBIOS cannot configure the framebuffer resolution.
  - Mac OS 9 on mac99 detects the real ATI Rage 128 Pro PCI device ID
    (0x1002:0x5046) and loads its native driver, which then accesses
    hardware registers that QEMU's ATI emulation does not implement,
    causing a hang before any display output appears.

Fix: add a MemoryRegion sub-region within the ATI MMIO space at
PCI_VGA_BOCHS_OFFSET (0x500), size PCI_VGA_BOCHS_SIZE (0x16 bytes),
whose read/write handlers delegate to the VGA common VBE ioport
functions already used internally by ati-vga for mode switching.

This makes ati-vga MMIO BAR2 behave identically to the standard QEMU
VGA for the purposes of OpenBIOS initialisation, so that:
  - OpenBIOS vga.fs successfully programs the display resolution.
  - qemu_vga.ndrv (the fw_cfg-resident QEMU VGA driver installed by
    OpenBIOS when vga-ndrv?=true) operates correctly on the ati-vga
    device, preventing Mac OS 9 from falling through to its native
    ATI driver.

Signed-off-by: Bruno Castelló <bfcastello@gmail.com>
---
 hw/display/ati.c     | 32 ++++++++++++++++++++++++++++++++
 hw/display/ati_int.h |  1 +
 2 files changed, 33 insertions(+)

diff --git a/hw/display/ati.c b/hw/display/ati.c
index d77589df67..0adb11be4b 100644
--- a/hw/display/ati.c
+++ b/hw/display/ati.c
@@ -1043,6 +1043,31 @@ static void ati_mm_write(void *opaque, hwaddr addr,
     }
 }

+static uint64_t ati_vga_bochs_read(void *opaque, hwaddr addr, unsigned size)
+{
+    VGACommonState *s = opaque;
+    vbe_ioport_write_index(s, 0, addr >> 1);
+    return vbe_ioport_read_data(s, 0);
+}
+
+static void ati_vga_bochs_write(void *opaque, hwaddr addr,
+                                uint64_t val, unsigned size)
+{
+    VGACommonState *s = opaque;
+    vbe_ioport_write_index(s, 0, addr >> 1);
+    vbe_ioport_write_data(s, 0, val);
+}
+
+static const MemoryRegionOps ati_vga_bochs_ops = {
+    .read = ati_vga_bochs_read,
+    .write = ati_vga_bochs_write,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+    .impl.min_access_size = 2,
+    .impl.max_access_size = 2,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
 static const MemoryRegionOps ati_mm_ops = {
     .read = ati_mm_read,
     .write = ati_mm_write,
@@ -1111,6 +1136,13 @@ static void ati_vga_realize(PCIDevice *dev, Error **errp)
                           "ati.mmregs", 0x4000);
     /* io space is alias to beginning of mmregs */
     memory_region_init_alias(&s->io, OBJECT(s), "ati.io", &s->mm, 0, 0x100);
+    /* Bochs VBE compatibility subregion at PCI_VGA_BOCHS_OFFSET (0x500).
+     * OpenBIOS vga.fs and qemu_vga.ndrv use this offset to program display
+     * modes on mac99. Without it Mac OS 9 falls through to its native ATI
+     * driver, which accesses unimplemented registers and hangs. */
+    memory_region_init_io(&s->vbe_compat, OBJECT(s), &ati_vga_bochs_ops,
+                          &s->vga, "ati-vbe-compat", PCI_VGA_BOCHS_SIZE);
+    memory_region_add_subregion(&s->mm, PCI_VGA_BOCHS_OFFSET, &s->vbe_compat);

     /*
      * The framebuffer is at the beginning of the linear aperture. For
diff --git a/hw/display/ati_int.h b/hw/display/ati_int.h
index 0c48934d33..de24508f9f 100644
--- a/hw/display/ati_int.h
+++ b/hw/display/ati_int.h
@@ -123,6 +123,7 @@ struct ATIVGAState {
     MemoryRegion linear_aper;
     MemoryRegion io;
     MemoryRegion mm;
+    MemoryRegion vbe_compat;
     ATIVGARegs regs;
     ATIHostDataState host_data;
 };
