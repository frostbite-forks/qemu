+#include "qemu/event_notifier.h"
 #include "vga-access.h"
 #include "hw/core/qdev-properties.h"
 #include "vga_regs.h"
@@ -1111,8 +1113,7 @@ static void ati_vgpu3d_ctrl_write(void *opaque, hwaddr addr,
     case VGPU3D_REG_DOORBELL:
         if (val) {
-            /* TODO Phase 5: wake Metal dispatch thread via eventfd/ioeventfd */
