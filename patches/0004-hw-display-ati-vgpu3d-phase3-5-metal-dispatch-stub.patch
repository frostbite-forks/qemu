         MemoryRegion ring_region;   /* ring data area   at BAR2+0x10000 */
         void        *ring_mem;      /* host-side mmap of ring data */
         uint32_t     ring_head;     /* guest-written enqueue index (read by host) */
         uint32_t     ring_tail;     /* host-written dequeue index (read by guest) */
-        /* Phase 5: Metal dispatch */
-        /* QemuThread      metal_thread; */
-        /* EventNotifier   doorbell_notifier; */
+        /* Phase 5: Metal dispatch thread */
+        QemuThread    metal_thread;
+        EventNotifier doorbell_notifier;
+        bool          running;
     } vgpu3d;
     MemoryRegion vbe_compat;
     ATIVGARegs regs;
