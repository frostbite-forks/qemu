@@ -1130,6 +1131,46 @@ static const MemoryRegionOps ati_vgpu3d_ctrl_ops = {
     .endianness = DEVICE_LITTLE_ENDIAN,
 };

+/* ---------------------------------------------------------------------------
+ * vgpu3d Phase 5: Metal dispatch thread — STUB
+ *
+ * Blocks on the doorbell eventfd, then drains ring packets into a Metal
+ * command encoder.  Metal API calls are left as TODOs until Phase 5.
+ * ------------------------------------------------------------------------- */
+
+static void *ati_vgpu3d_thread(void *opaque)
+{
+    ATIVGAState *s = opaque;
+    int fd = event_notifier_get_fd(&s->vgpu3d.doorbell_notifier);
+
+    while (s->vgpu3d.running) {
+        fd_set rfds;
+        FD_ZERO(&rfds);
+        FD_SET(fd, &rfds);
+        if (select(fd + 1, &rfds, NULL, NULL, NULL) < 0) {
+            break;
+        }
+        if (!event_notifier_test_and_clear(&s->vgpu3d.doorbell_notifier)) {
+            continue;
+        }
+        if (!s->vgpu3d.running) {
+            break;
+        }
+
+        /* TODO Phase 5: drain ring packets → Metal command encoder       */
+        /* while (s->vgpu3d.ring_tail != s->vgpu3d.ring_head) {           */
+        /*     process_vgpu3d_packet(s);                                    */
+        /*     smp_mb();                                                    */
+        /* }                                                                */
+        (void)s;
+    }
+    return NULL;
+}
+
 static void ati_vgpu3d_realize(ATIVGAState *s, Error **errp)
 {
     /* Allocate host ring buffer memory (accessible by both QEMU and Metal) */
@@ -1173,10 +1214,21 @@ static void ati_vgpu3d_realize(ATIVGAState *s, Error **errp)
     memory_region_set_readonly(&s->vgpu3d.ring_region, false);
     memory_region_add_subregion(&s->mm, VGPU3D_RING_OFFSET,
                                 &s->vgpu3d.ring_region);
+
+    /* Phase 5: init doorbell notifier and start Metal dispatch thread */
+    if (event_notifier_init(&s->vgpu3d.doorbell_notifier, 0) < 0) {
+        error_setg(errp, "vgpu3d: failed to init doorbell notifier");
+        munmap(s->vgpu3d.ring_mem, VGPU3D_RING_DATA_SIZE);
+        return;
+    }
+    s->vgpu3d.running = true;
+    qemu_thread_create(&s->vgpu3d.metal_thread, "vgpu3d-metal",
+                       ati_vgpu3d_thread, s, QEMU_THREAD_JOINABLE);
 }

 /* ati_vga_bochs_{read,write} and ati_mm_ops unchanged from patch 0002 */
 /* ... */

@@ -1197,6 +1239,15 @@ static void ati_vga_realize(PCIDevice *dev, Error **errp)
 static void ati_vga_exit(PCIDevice *dev)
 {
     ATIVGAState *s = ATI_VGA(dev);
+
+    /* vgpu3d: stop Metal dispatch thread before device teardown */
+    if (s->vgpu3d.running) {
+        s->vgpu3d.running = false;
+        event_notifier_set(&s->vgpu3d.doorbell_notifier);
+        qemu_thread_join(&s->vgpu3d.metal_thread);
+        event_notifier_cleanup(&s->vgpu3d.doorbell_notifier);
+        munmap(s->vgpu3d.ring_mem, VGPU3D_RING_DATA_SIZE);
+    }

     timer_del(&s->vblank_timer);
     qemu_graphic_console_close(s->vga.con);
