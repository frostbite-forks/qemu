diff --git a/hw/display/ati.c b/hw/display/ati.c
index 000000000003..000000000004 100644
--- a/hw/display/ati.c
+++ b/hw/display/ati.c
@@ -19,6 +19,8 @@
 #include "qemu/osdep.h"
 #include "ati_int.h"
 #include "ati_regs.h"
